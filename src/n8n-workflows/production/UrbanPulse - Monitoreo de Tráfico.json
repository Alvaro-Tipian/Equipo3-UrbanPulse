        "jsCode": "const tomtom = $json.flowSegmentData;\nconst punto = $('Execute a SQL query').item.json;\n\nconst velocidadActual = tomtom.currentSpeed;\nconst velocidadNormal = tomtom.freeFlowSpeed;\nconst congestion = ((velocidadNormal - velocidadActual) / velocidadNormal) * 100;\n\nreturn {\n  json: {\n    punto_nombre: punto.nombre,\n    velocidad_actual: velocidadActual,\n    velocidad_normal: velocidadNormal,\n    porcentaje_congestion: Number(congestion.toFixed(1)),\n    estado: congestion > 30 ? 'Congestionado' : 'Fluido'\n  }\n};"
