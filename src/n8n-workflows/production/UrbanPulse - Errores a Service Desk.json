      "id": "a1e2c3d4-1111-4a5b-9c6d-000000000001",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const wf = $json.workflow || {};\nconst exec = $json.execution || {};\nconst err = exec.error || {};\n\nconst workflowName = wf.name || 'Workflow desconocido';\nconst lastNode = exec.lastNodeExecuted || (err.node && err.node.name) || 'Nodo desconocido';\nconst errorMessage = err.message || 'Sin mensaje de error';\nconst executionUrl = exec.url || '';\nconst fecha = new Date().toISOString();\n\n// Prioridad: Alta para Central vr5 y auth; Media para el resto\nconst nombreNormalizado = workflowName.toLowerCase();\nconst prioridad = (nombreNormalizado.includes('central vr5') || nombreNormalizado.includes('auth'))\n  ? 'Alta'\n  : 'Media';\n\n// Slug del nombre del workflow para la etiqueta wf-<nombre>\nconst slug = workflowName\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/(^-|-$)/g, '');\n\nconst etiquetaWorkflow = `wf-${slug}`;\nconst resumen = `[n8n] ${workflowName} fallo en ${lastNode}`;\nconst descripcionTexto = `Workflow: ${workflowName}\\nNodo: ${lastNode}\\nError: ${errorMessage}\\nEjecucion: ${executionUrl}\\nFecha: ${fecha}`;\n\nreturn {\n  json: {\n    workflowName,\n    lastNode,\n    errorMessage,\n    executionUrl,\n    fecha,\n    prioridad,\n    etiquetaWorkflow,\n    resumen,\n    descripcionTexto,\n    jql: `project = UPTI AND labels = \"${etiquetaWorkflow}\" AND created >= -15m ORDER BY created DESC`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -576,
        0
      ],
      "id": "a1e2c3d4-1111-4a5b-9c6d-000000000002",
      "name": "Armar datos del ticket"
    },
