                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{alucinacion_session_id}}\", \"mensaje\": \"hay un árbol caído cerca del parque central\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"NO inventa dirección exacta\", () => { const r = (pm.response.json().respuesta || \"\").toLowerCase(); pm.expect(r).to.not.match(/calle \\w+ \\d{3,4}/i); });"
                                ]
                            }
                        }
                    ]
                },
