{
    "info": {
        "_postman_id": "405b4c7c-807e-469f-bb9e-eac08a9eb81d",
        "name": "UrbanPulse - Pruebas QA",
        "description": "Colección organizada por TIPO DE PRUEBA (funcionales, negativas, seguridad, consistencia del LLM, integración externa) contra el workflow real de producción 'UrbanPulse - Central' (webhook POST /webhook/urbanpulse/chat).\n\nOJO: el flujo real tiene 3 estados -- recolectando -> confirmando -> completado -- con una validación de contenido por LLM y un paso explícito de confirmación 'sí/no' antes de clasificar. Esto NO coincide con la hoja de Criterios de Aceptación de PRODUCT_BACKLOG_ACTUALIZADO (que describe esperando_imagen/esperando_ubicacion, sin paso de confirmación ni validación de contenido) -- ese documento quedó desactualizado respecto a lo implementado y conviene reportarlo al equipo/PO.\n\nCada carpeta de HU-01 usa un session_id generado dinámicamente en el pre-request script del primer paso (para no ensuciar la base de datos real de producción con IDs fijos reutilizados entre corridas) y debe correr en el orden en que aparece.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Pruebas Funcionales (camino feliz completo)",
            "item": [
                {
                    "name": "Paso 1 - Descripcion del incidente",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{func_session_id}}\", \"mensaje\": \"Hay un bache gigante en la avenida\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.environment.set('func_session_id', 'qa-func-' + Date.now());"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"estado: recolectando\", () => pm.expect(pm.response.json().estado).to.eql(\"recolectando\"));",
                                    "pm.test(\"Pide la foto\", () => pm.expect((pm.response.json().respuesta || \"\").toLowerCase()).to.match(/foto/));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Paso 2 - Evadir foto (no tengo foto)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{func_session_id}}\", \"mensaje\": \"no tengo foto\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"estado: recolectando\", () => pm.expect(pm.response.json().estado).to.eql(\"recolectando\"));",
                                    "pm.test(\"Pide la ubicacion\", () => pm.expect((pm.response.json().respuesta || \"\").toLowerCase()).to.match(/ubicaci[oó]n/));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Paso 3 - Enviar ubicacion (pasa a confirmando)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{func_session_id}}\", \"latitude\": -12.0464, \"longitude\": -77.0428 }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"estado: confirmando\", () => pm.expect(pm.response.json().estado).to.eql(\"confirmando\"));",
                                    "pm.test(\"Pide confirmacion con el resumen del reporte\", () => {",
                                    "  const r = (pm.response.json().respuesta || '').toLowerCase();",
                                    "  pm.expect(r).to.match(/confirmas/);",
                                    "  pm.expect(r).to.include('descripci');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Paso 4 - Confirmar (si) y clasificar",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{func_session_id}}\", \"mensaje\": \"si\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "const json = pm.response.json();",
                                    "pm.test(\"estado: completado\", () => pm.expect(json.estado).to.eql(\"completado\"));",
                                    "pm.test(\"Incluye tipo_incidente\", () => pm.expect(json.tipo_incidente).to.exist);",
                                    "pm.test(\"Incluye prioridad\", () => pm.expect(json.prioridad).to.exist);",
                                    "pm.test(\"Incluye score_riesgo\", () => pm.expect(json.score_riesgo).to.exist);",
                                    "pm.environment.set(\"hu01_incident_type\", json.tipo_incidente);"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "2. Pruebas Negativas y de Borde",
            "item": [
                {
                    "name": "N1 - Mensaje sin sentido es rechazado por el validador de contenido",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"qa-neg-contenido-{{$timestamp}}\", \"mensaje\": \"asdasd jajaja prueba prueba\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// El validador de contenido (LLM) debe rechazar texto sin sentido y seguir",
                                    "// pidiendo una descripcion real, sin avanzar de estado ni tirar un error HTTP.",
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"estado: recolectando (no avanza)\", () => pm.expect(pm.response.json().estado).to.eql(\"recolectando\"));",
                                    "pm.test(\"Pide una descripcion valida\", () => {",
                                    "  pm.expect((pm.response.json().respuesta || '')).to.include('incidente urbano');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "N2 - Sesion ya completada rechaza datos nuevos",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{func_session_id}}\", \"mensaje\": \"Otro bache mas\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Depende de que la carpeta '1. Pruebas Funcionales' haya corrido antes",
                                    "// (reutiliza func_session_id, que a esa altura ya quedo 'completado').",
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"Informa que el reporte ya fue registrado\", () => {",
                                    "  pm.expect((pm.response.json().respuesta || \"\").toLowerCase()).to.include(\"ya fue registrado\");",
                                    "});",
                                    "pm.test(\"estado: completado\", () => pm.expect(pm.response.json().estado).to.eql(\"completado\"));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "N3 - Rechazar el resumen (no) reinicia la conversacion",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{neg_reinicio_session_id}}\", \"mensaje\": \"no\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Esta prueba necesita llegar a 'confirmando' primero: dispara los 3 pasos",
                                    "// del camino feliz de forma sincrona contra el mismo n8n_webhook_url antes",
                                    "// de la request real (que manda 'no').",
                                    "const sessionId = 'qa-neg-reinicio-' + Date.now();",
                                    "pm.environment.set('neg_reinicio_session_id', sessionId);",
                                    "const base = pm.environment.get('n8n_webhook_url');",
                                    "",
                                    "pm.sendRequest({",
                                    "  url: base, method: 'POST',",
                                    "  header: { 'Content-Type': 'application/json' },",
                                    "  body: { mode: 'raw', raw: JSON.stringify({ session_id: sessionId, mensaje: 'Un poste de luz caido en la esquina' }) }",
                                    "}, () => {",
                                    "  pm.sendRequest({",
                                    "    url: base, method: 'POST',",
                                    "    header: { 'Content-Type': 'application/json' },",
                                    "    body: { mode: 'raw', raw: JSON.stringify({ session_id: sessionId, mensaje: 'no tengo foto' }) }",
                                    "  }, () => {",
                                    "    pm.sendRequest({",
                                    "      url: base, method: 'POST',",
                                    "      header: { 'Content-Type': 'application/json' },",
                                    "      body: { mode: 'raw', raw: JSON.stringify({ session_id: sessionId, latitude: -12.0464, longitude: -77.0428 }) }",
                                    "    }, () => {});",
                                    "  });",
                                    "});"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                                    "pm.test(\"estado: recolectando (reinicio)\", () => pm.expect(pm.response.json().estado).to.eql(\"recolectando\"));",
                                    "pm.test(\"Confirma el reinicio\", () => pm.expect((pm.response.json().respuesta || '')).to.include('empecemos de nuevo'));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
