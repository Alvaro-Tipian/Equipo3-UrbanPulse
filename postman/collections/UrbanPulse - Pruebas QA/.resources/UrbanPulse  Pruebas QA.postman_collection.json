                                    "pm.test(\"Estado: completado\", () => pm.expect(pm.response.json().estado).to.eql(\"completado\"));",
                                    "pm.test(\"Tipo válido (no inventado)\", () => { const tipos = [\"bache\", \"semaforo\", \"agua_saneamiento\", \"residuos\", \"arbolado\", \"incendio\", \"otro\"]; pm.expect(tipos).to.include(pm.response.json().tipo_incidente); });",
