            "name": "10. Pruebas de Alucinación",
            "item": [
                {
                    "name": "Caso 1 - Input vago sin invenciones (dirección/email/teléfono)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{n8n_webhook_url}}",
                            "host": [
                                "{{n8n_webhook_url}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"session_id\": \"{{alucinacion_session_id}}\", \"mensaje\": \"hay un incidente en la ciudad\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.environment.set('alucinacion_session_id', 'qa-alucinacion-' + Date.now());"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                                    "pm.test('NO inventa dirección ficticia', () => { const r = (pm.response.json().respuesta || '').toLowerCase(); pm.expect(r).to.not.match(/^(calle|avenida|jr) .*\\\\d{3,4}/i); });"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Caso 2 - Ubicación vaga sin coordenadas exactas inventadas",
                    "request": {
                        "method": "POST",
                        "header": [
