                  "// respuesta del webhook). Este test deja constancia del gap en vez de",
                  "// omitirse en silencio: hoy DEBE fallar. En cuanto HT-30 anada un",
                  "// campo trace_id (o header equivalente) a la respuesta, actualizar",
                  "// esta prueba para validar el formato real y correlacionar con",
                  "// Langfuse Cloud (por ejemplo, un segundo request a su API con ese id).",
                  "const json = pm.response.json();",
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"[GAP HT-30] La respuesta incluye un trace_id correlacionable con Langfuse\", () => {",
                  "  pm.expect(json.trace_id || pm.response.headers.get('X-Langfuse-Trace-Id')).to.exist;",
                  "});",
                  "",
                  "const times = JSON.parse(pm.collectionVariables.get('llm_response_times') || '[]');",
                  "times.push(pm.response.responseTime);",
                  "pm.collectionVariables.set('llm_response_times', JSON.stringify(times));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{n8n_webhook_url}}",
              "host": ["{{n8n_webhook_url}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"session_id\": \"{{lf_session_id}}\", \"mensaje\": \"Hay un poste sin luz en mi cuadra\" }",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Resumen",
      "item": [
        {
          "name": "5.1 - Latencia p95 de toda la suite < 3s",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('resumen_session_id', 'qa-resumen-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const times = JSON.parse(pm.collectionVariables.get('llm_response_times') || '[]');",
                  "times.push(pm.response.responseTime);",
                  "times.sort((a, b) => a - b);",
                  "const idx = Math.min(times.length - 1, Math.ceil(0.95 * times.length) - 1);",
                  "const p95 = times[idx];",
                  "pm.test(`Latencia p95 de la suite < 3000ms (p95=${p95}ms, n=${times.length})`, () => {",
                  "  pm.expect(p95).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{n8n_webhook_url}}",
              "host": ["{{n8n_webhook_url}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"session_id\": \"{{resumen_session_id}}\", \"mensaje\": \"Hay basura acumulada en la esquina\" }",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    }
  ]
