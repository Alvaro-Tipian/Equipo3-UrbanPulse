            "{{base_url}}"
          ],
          "path": [
            "webhook",
            "urbanpulse",
            "eventos"
          ]
        },
        "description": "El tipo no pertenece al catalogo. El evento queda en eventos con estado 'rechazado' y no se entrega."
      }
    },
