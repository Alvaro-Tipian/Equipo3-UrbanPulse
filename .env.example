# Copia este archivo a .env y completa los valores. NUNCA subas .env (ya está
# en .gitignore) ni ninguna clave real a este repositorio.

# --- PostgreSQL (infrastructure/docker-compose.yml) ---
POSTGRES_USER=urban_admin
POSTGRES_PASSWORD=urban_password_local
POSTGRES_DB=urbanpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Autenticación (login de operadores) ---
# Secreto usado por src/n8n-workflows/production/urbanpulse-auth.json para
# firmar (HMAC-SHA256) los tokens de sesión emitidos al iniciar sesión.
N8N_AUTH_SECRET=urbanpulse_dev_secret_local

# --- LLM para clasificación de incidentes (opcional en esta PoC) ---
# Si ninguna de las dos está configurada, el workflow
# src/n8n-workflows/production/urbanpulse-report.json usa un nodo Function
# que simula la clasificación con reglas de palabras clave (mock).
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Verificación end-to-end de la PoC desplegada (scripts/verify-poc-deployment.js) ---
# URL del frontend desplegado en Vercel.
FRONTEND_URL=
# URL del webhook de producción de n8n desplegado en AWS Lightsail.
N8N_WEBHOOK_URL=
# Conexión directa a PostgreSQL en Neon (para validar lo que persistió el webhook).
# Esta conexión directa está bien para la verificación puntual de este script.
# La credencial Postgres que usa n8n en producción sí recibe tráfico
# concurrente real: esa debe apuntar al endpoint pooled de Neon (el host con
# "-pooler" en la connection string), no a este directo, para no agotar el
# cupo de conexiones del compute bajo carga (ver
# database/migrations/20260917000001_fix_limitar_conexiones_connection_limit.sql).
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# --- Frontend & Microfrontends (Producción Vercel) ---
# En producción, estas variables se configuran como cifradas/sensibles en la consola de Vercel.
# NUNCA subas claves reales al repositorio. Ver guía en: docs/VERCEL_PRODUCTION_KEYS_HARDENING.md
VITE_TOMTOM_API_KEY=
TE_N8N_WEBHOOK_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/chat
TE_N8N_REPORTS_LIST_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/reports-list
TE_N8N_REPORT_IMAGE_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/report-image
TE_N8N_DASHBOARD_KPIS_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/dashboard-kpis
TE_N8N_AUTH_LOGIN_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/auth/login
TE_N8N_REPORTS_HISTORY_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/reports-history
TE_N8N_REPORT_RESOLVE_URL=https://urbanpulse-n8n.xq33kajky1yy6.us-east-1.cs.amazonlightsail.com/webhook/urbanpulse/report-resolve
