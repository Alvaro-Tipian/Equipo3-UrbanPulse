# Copia este archivo a .env y completa los valores. NUNCA subas .env (ya está
# en .gitignore) ni ninguna clave real a este repositorio.

# --- PostgreSQL (infrastructure/docker-compose.yml) ---
POSTGRES_USER=urban_admin
POSTGRES_PASSWORD=urban_password_local
POSTGRES_DB=urbanpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM para clasificación de incidentes (opcional en esta PoC) ---
# Si ninguna de las dos está configurada, el workflow
# src/n8n-workflows/production/urbanpulse-report.json usa un nodo Function
# que simula la clasificación con reglas de palabras clave (mock).
GEMINI_API_KEY=
GROQ_API_KEY=
